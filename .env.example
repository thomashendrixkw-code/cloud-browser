# Toutes ces variables sont FACULTATIVES : l'application démarre sans .env.
# Copiez ce fichier en .env et décommentez ce que vous voulez changer.

# --- Serveur ---
# PORT=8787
# HOST=127.0.0.1          # sortir de la boucle locale exige ACCESS_PASSWORD
# LOG_LEVEL=info          # error | warn | info | debug
# TRUST_PROXY=true        # uniquement derrière un reverse proxy de confiance

# --- Accès (uniquement si le service doit être joignable d'ailleurs) ---
# ACCESS_USER=admin
# ACCESS_PASSWORD=
# AUTH_USERS=alice:motdepasse,bob:autre     # plusieurs comptes (prioritaire)
# AUTH_SECRET=            # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECURE_COOKIE=true # dès que le service est servi en HTTPS
# ALLOW_UNAUTHENTICATED_EXPOSURE=false      # true = proxy ouvert, à vos risques

# --- Sessions ---
# HOME_URL=https://exemple.fr   # remplace la page d'accueil intégrée
# SEARCH_ENGINE=duckduckgo      # google | duckduckgo | bing | qwant | brave | ecosia
# MAX_SESSIONS=3
# MAX_SESSIONS_PER_USER=0 # 0 = pas de quota par compte
# SESSION_IDLE_MINUTES=10
# VIEWPORT_WIDTH=1280
# VIEWPORT_HEIGHT=720

# --- Streaming ---
# STREAM_MODE=screencast  # screencast (CDP) | poll (captures périodiques)
# JPEG_QUALITY=60         # qualité de départ (78 détecté en Codespace)
# POLL_INTERVAL_MS=250
# ADAPTIVE_QUALITY=true   # régule la qualité d'après la latence mesurée
# MIN_JPEG_QUALITY=35
# MAX_JPEG_QUALITY=88
# TARGET_LATENCY_MS=180   # gonflement d'aller-retour toléré avant de céder

# --- Chromium ---
# HEADLESS=true
# CHROMIUM_SANDBOX=true   # false en conteneur (déjà réglé pour les Codespaces)
# BROWSER_RESTART_HOURS=8 # rotation du process, anti fuite mémoire
