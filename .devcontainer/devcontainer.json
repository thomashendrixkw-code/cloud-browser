{
  "name": "Cloud Browser",

  // Image officielle Playwright : Chromium et ses dépendances système sont déjà
  // présents, `npm install` n'a donc rien à télécharger côté navigateur.
  // Sa version doit rester alignée sur celle de "playwright" dans package.json.
  "image": "mcr.microsoft.com/playwright:v1.49.1-jammy",

  // Volontairement aucune commande de cycle de vie : pas de `postCreateCommand`
  // ni de démarrage automatique. Une installation qui échoue en arrière-plan est
  // plus déroutante que deux commandes explicites (voir le README), et un
  // serveur lancé tout seul entre en collision avec celui qu'on lance soi-même.

  // 2 cœurs suffisent à démarrer ; 4 rendent le flux nettement plus fluide,
  // l'encodage JPEG étant le poste de calcul dominant.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "containerEnv": {
    // Le sandbox Chromium n'existe pas dans ce conteneur. Acceptable ici : le
    // port n'est joignable qu'à travers le tunnel HTTPS privé de GitHub.
    "CHROMIUM_SANDBOX": "false"
  },

  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "Cloud Browser",
      "onAutoForward": "openPreview",
      "protocol": "https"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
